{
  "id": "apy",
  "level": "central",
  "state": null,
  "category": "pension",
  "benefit_weight": 1000,
  "name": {
    "en": "Atal Pension Yojana",
    "ta": "அடல் ஓய்வூதியத் திட்டம்",
    "hi": "अटल पेंशन योजना"
  },
  "benefit": {
    "en": "Guaranteed pension of ₹1,000 – ₹5,000 a month from age 60, for a small monthly saving",
    "ta": "சிறிய மாதச் சேமிப்பிற்கு, 60 வயது முதல் மாதம் ₹1,000 – ₹5,000 உறுதியான ஓய்வூதியம்",
    "hi": "छोटी मासिक बचत पर 60 वर्ष से ₹1,000 – ₹5,000 मासिक गारंटीड पेंशन"
  },
  "clauses": [
    {
      "id": "age",
      "rule": {
        "between": [
          {
            "var": "age"
          },
          18,
          40
        ]
      },
      "text": {
        "en": "Aged 18 to 40",
        "ta": "18 முதல் 40 வயது",
        "hi": "18 से 40 वर्ष आयु"
      },
      "source": {
        "title": "PFRDA — Atal Pension Yojana FAQs",
        "url": "https://pfrda.org.in/web/pfrda/w/faqs/atal-pension-yojana",
        "locator": "Eligibility",
        "quality": "official"
      }
    },
    {
      "id": "bank",
      "rule": {
        "==": [
          {
            "var": "has_bank_account"
          },
          true
        ]
      },
      "text": {
        "en": "Has a savings bank or post office account",
        "ta": "சேமிப்பு வங்கி அல்லது அஞ்சலகக் கணக்கு உள்ளது",
        "hi": "बचत बैंक या डाकघर खाता है"
      },
      "source": {
        "title": "PFRDA — Atal Pension Yojana FAQs",
        "url": "https://pfrda.org.in/web/pfrda/w/faqs/atal-pension-yojana",
        "locator": "Eligibility",
        "quality": "official"
      }
    },
    {
      "id": "no_tax",
      "rule": {
        "==": [
          {
            "var": "pays_income_tax"
          },
          false
        ]
      },
      "text": {
        "en": "Has never been an income-tax payer (rule from 1 Oct 2022)",
        "ta": "வருமான வரி செலுத்துபவராக இருந்ததில்லை (1 அக். 2022 முதல் விதி)",
        "hi": "कभी आयकरदाता नहीं रहे (1 अक्टूबर 2022 से नियम)"
      },
      "source": {
        "title": "PFRDA — Atal Pension Yojana FAQs",
        "url": "https://pfrda.org.in/web/pfrda/w/faqs/atal-pension-yojana",
        "locator": "Eligibility",
        "quality": "official"
      }
    }
  ],
  "required_documents": [
    "aadhaar",
    "bank_passbook"
  ],
  "apply_at": {
    "en": "Your bank or post office branch",
    "ta": "உங்கள் வங்கி அல்லது அஞ்சலகக் கிளை",
    "hi": "आपकी बैंक या डाकघर शाखा"
