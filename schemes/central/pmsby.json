  "clauses": [
    {
      "id": "age",
      "rule": {
        "between": [
          {
            "var": "age"
          },
          18,
          70
        ]
      },
      "text": {
        "en": "Aged 18 to 70",
        "ta": "18 முதல் 70 வயது",
        "hi": "18 से 70 वर्ष आयु"
      },
      "source": {
