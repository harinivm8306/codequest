  "office_checks": [
    {
      "en": "Other poor families can apply with a self-declaration form at the distributor",
      "ta": "பிற ஏழைக் குடும்பங்கள் விநியோகஸ்தரிடம் சுய அறிவிப்புப் படிவத்துடன் விண்ணப்பிக்கலாம்",
      "hi": "अन्य गरीब परिवार वितरक के पास स्व-घोषणा पत्र से आवेदन कर सकते हैं"
    }
