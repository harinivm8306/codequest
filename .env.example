# Copy to .env and fill in. Never commit .env. Every variable is optional:
# with none set, SchemeSathi runs on SQLite, the keyword extractor and browser speech.

# --- Database (default: SQLite file in backend/). Supabase / Neon connection string works too.
DATABASE_URL=

# --- Claude (fact extraction + phrasing cited answers). Without it: deterministic keyword extractor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_TIMEOUT_S=8

# --- Bhashini (speech-to-text, text-to-speech). Without it: the browser's speech APIs.
# Register at https://bhashini.gov.in/ulca and generate a key under My Profile.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_TIMEOUT_S=6

# --- Security and privacy
# Long random string: salts phone/token hashes and signs packet download links.
HASH_SALT=
DOCUMENT_RETENTION_HOURS=24
PROFILE_INACTIVE_DAYS=90
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_MB=5

# --- Only when the frontend is hosted separately (e.g. Vercel)
CORS_ORIGINS=http://localhost:3000
# frontend/.env.local:  NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
